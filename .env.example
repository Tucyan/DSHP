# Isolated project runtime (never point these at your normal DSH profile)
PGA_WEB_PORT=3180
DSH_HOME=./runtime/dsh-home
DSH_AGENTS_HOME=./runtime/agents-home
DSH_WORKSPACE=./workspace

# Optional live QQ deployment references. The secret value is never stored here.
QQ_PEER_ID=replace-with-your-single-qq-peer-id
QQ_APP_ID=replace-with-your-app-id
QQ_APP_SECRET_ENV=QQ_APP_SECRET
# QQ_APP_SECRET=use-your-local-secret-manager-or-process-environment
