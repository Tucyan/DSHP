{
  "name": "personal-growth-agent",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "architecture": "node scripts/serve-architecture.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b && pnpm --filter @personal-growth/admin-web typecheck",
    "build": "tsc -b && pnpm --filter @personal-growth/admin-web build",
    "admin:token": "node packages/dsh-host/dist/admin/token-cli.js show",
    "admin:token:rotate": "node packages/dsh-host/dist/admin/token-cli.js rotate",
    "lint": "eslint .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "demo": "pnpm --filter @personal-growth/runtime build && node packages/runtime/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@types/node": "24.10.2",
    "eslint": "9.23.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.26.0",
    "vitest": "3.2.4"
  }
}
