# Copy to /etc/dshp/dshp.env, fill the four required values, and chmod 600.
# Do not commit the populated server file.
PGA_REPO_ROOT=/opt/dshp
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_ALLOWED_PEER_ID=
DEEPSEEK_API_KEY=

# Optional QQ bot account identifier. Leave empty unless your bot requires it.
QQBOT_ACCOUNT_ID=

# The admin server is hard-bound to 127.0.0.1 by the application.
PGA_ADMIN_PORT=3182
PGA_TIMEZONE=Asia/Singapore
PGA_QUIET_START=23:00
PGA_QUIET_END=07:00
PGA_COOLDOWN_MINUTES=120
PGA_MAX_CONTACTS_PER_DAY=4

# Keep the unattended agent inside its workspace and within this small host.
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1
NODE_OPTIONS=--max-old-space-size=768
